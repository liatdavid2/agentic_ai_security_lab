#!/usr/bin/env bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl git nginx snapd

# Docker Engine + Compose plugin
curl -fsSL https://get.docker.com | sh
usermod -aG docker ubuntu

# Ollama host daemon
curl -fsSL https://ollama.com/install.sh | sh

# Allow Docker containers to reach Ollama through the EC2 host.
# Port 11434 is NOT opened in the AWS security group, so it remains internal.
mkdir -p /etc/systemd/system/ollama.service.d
cat >/etc/systemd/system/ollama.service.d/override.conf <<'OLLAMAEOF'
[Service]
Environment="OLLAMA_HOST=0.0.0.0:11434"
OLLAMAEOF

systemctl daemon-reload
systemctl enable ollama
systemctl restart ollama

# Clone/update repository
install -d -o ubuntu -g ubuntu /opt/agentic_ai_security_lab
if [ ! -d /opt/agentic_ai_security_lab/.git ]; then
  rm -rf /opt/agentic_ai_security_lab
  git clone --branch '${repo_branch}' --single-branch '${repo_url}' /opt/agentic_ai_security_lab
else
  cd /opt/agentic_ai_security_lab
  git fetch origin '${repo_branch}'
  git reset --hard 'origin/${repo_branch}'
fi

cd /opt/agentic_ai_security_lab

# Start Docker services on their existing host ports 8101/8102.
# These ports are not public in the AWS security group; Nginx proxies to them locally.
docker compose up -d --build

# Obtain the ephemeral public IPv4 using IMDSv2.
IMDS_TOKEN="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600')"
PUBLIC_IP="$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4)"

# Stop nginx temporarily so Certbot standalone can answer the ACME HTTP-01 challenge on port 80.
systemctl stop nginx || true

# Current Certbot with IP-certificate support. Let's Encrypt IP certificates are short-lived
# (~6 days), which is ideal for this apply -> demo -> destroy workflow.
snap install core || true
snap refresh core || true
snap install --classic certbot
ln -sf /snap/bin/certbot /usr/local/bin/certbot

# Request a publicly trusted, free IP-address certificate from Let's Encrypt.
# --register-unsafely-without-email avoids requiring an email for this disposable demo.
certbot certonly \
  --non-interactive \
  --agree-tos \
  --register-unsafely-without-email \
  --preferred-profile shortlived \
  --standalone \
  --ip-address "$PUBLIC_IP"

CERT_DIR="/etc/letsencrypt/live/$PUBLIC_IP"

# Nginx terminates TLS. BLUE is public on 443; RED is public on 8443.
# The applications themselves stay on localhost-style host ports 8101/8102.
cat >/etc/nginx/sites-available/agentic-ai-security-lab <<NGINXEOF
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $PUBLIC_IP;

    ssl_certificate     $CERT_DIR/fullchain.pem;
    ssl_certificate_key $CERT_DIR/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8101;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name $PUBLIC_IP;

    ssl_certificate     $CERT_DIR/fullchain.pem;
    ssl_certificate_key $CERT_DIR/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8102;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
NGINXEOF

rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/agentic-ai-security-lab /etc/nginx/sites-enabled/agentic-ai-security-lab
nginx -t
systemctl enable nginx
systemctl restart nginx

# Renewal timer is harmless for longer demos. Reload nginx after any renewed certificate.
mkdir -p /etc/letsencrypt/renewal-hooks/deploy
cat >/etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh <<'EOFHOOK'
#!/usr/bin/env bash
systemctl reload nginx
EOFHOOK
chmod +x /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh
systemctl enable --now snap.certbot.renew.timer 2>/dev/null || true

# Basic bootstrap diagnostics
systemctl is-active --quiet docker
systemctl is-active --quiet ollama
systemctl is-active --quiet nginx
ss -ltn | grep -q ':11434'
ss -ltn | grep -q ':443'
ss -ltn | grep -q ':8443'

cat >/etc/motd <<EOF
agentic_ai_security_lab demo host

BLUE TEAM HTTPS: https://$PUBLIC_IP
RED TEAM HTTPS:  https://$PUBLIC_IP:8443

HTTPS uses a free, publicly trusted Let's Encrypt IP certificate.
No domain, Route 53, ALB, or paid TLS certificate is required.
The certificate is short-lived and is created automatically for each fresh EC2 public IP.

IMPORTANT for RED TEAM Ollama Cloud:
1. Run: ollama signin
2. Test: ollama run gpt-oss:20b-cloud "Say hello"
3. The Docker RED TEAM service then uses the host Ollama API.

Useful logs:
  sudo journalctl -u ollama -n 100 --no-pager
  sudo journalctl -u nginx -n 100 --no-pager
  sudo tail -n 150 /var/log/cloud-init-output.log
  cd /opt/agentic_ai_security_lab && docker compose logs --tail=150

Do not expose port 11434 publicly.

EOF
