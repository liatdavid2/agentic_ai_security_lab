#!/usr/bin/env bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl git

# Docker Engine + Compose plugin
curl -fsSL https://get.docker.com | sh
usermod -aG docker ubuntu

# Ollama host daemon
curl -fsSL https://ollama.com/install.sh | sh
systemctl enable ollama
systemctl start ollama

# Clone/update repository
install -d -o ubuntu -g ubuntu /opt/agentic_ai_security_lab
if [ ! -d /opt/agentic_ai_security_lab/.git ]; then
  rm -rf /opt/agentic_ai_security_lab
  git clone --branch '${repo_branch}' --single-branch '${repo_url}' /opt/agentic_ai_security_lab
else
  cd /opt/agentic_ai_security_lab
  git fetch origin '${repo_branch}'
  git reset --hard 'origin/${repo_branch}'
fi

cd /opt/agentic_ai_security_lab

# Start only the Docker services. The UIs will come up immediately.
# RED TEAM cloud inference will work after the Ollama account is connected on this host.
docker compose up -d --build

cat >/etc/motd <<'EOF'
agentic_ai_security_lab demo host

BLUE TEAM: http://<PUBLIC_IP>:8101
RED TEAM:  http://<PUBLIC_IP>:8102

IMPORTANT for RED TEAM Ollama Cloud:
1. Connect to this host (SSH if a key_name was configured).
2. Run: ollama signin
3. Test: ollama run gpt-oss:20b-cloud "Say hello"
4. The Docker RED TEAM service will then use the host Ollama API.

Do not expose port 11434 publicly.
EOF
